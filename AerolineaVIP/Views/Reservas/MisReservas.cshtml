@model AerolineaVIP.Models.MisReservasViewModel
@{
    ViewBag.Title = "Mis Reservas - Portal Cliente VIP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <span>@TempData["MensajeExito"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
            <span>@TempData["MensajeError"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Encabezado del Portal -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-4 mb-4 border-bottom">
        <div>
            <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-bold text-uppercase mb-2">Portal Ejecutivo</span>
            <h1 class="h2 fw-bold text-dark mb-1">Mis Reservas</h1>
            <p class="text-muted mb-0">Consulte, gestione o descargue los comprobantes fiscales de sus vuelos en flota ejecutiva Phenom 300E.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="@Url.Action("Buscar", "Vuelos")" class="btn btn-outline-danger fw-bold rounded-pill px-4">
                <i class="bi bi-search me-1"></i> Nueva Reserva
            </a>
            <a href="@Url.Action("Index", "CheckIn")" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm" style="background-color: #E1251B; border-color: #E1251B;">
                <i class="bi bi-qr-code me-1"></i> Check-in en Línea
            </a>
        </div>
    </div>

    <!-- Pestañas de Filtro de Reservas -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(Model.FiltroActual == "todas" ? "active bg-danger text-white" : "text-dark bg-light")"
               href="@Url.Action("MisReservas", "Reservas", new { tab = "todas" })">
                Todas <span class="badge rounded-pill ms-1 @(Model.FiltroActual == "todas" ? "bg-white text-danger" : "bg-secondary text-white")">@(Model.TotalProximas + Model.TotalCompletadas + Model.TotalCanceladas)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(Model.FiltroActual == "proximas" ? "active bg-danger text-white" : "text-dark bg-light")"
               href="@Url.Action("MisReservas", "Reservas", new { tab = "proximas" })">
                Próximas <span class="badge rounded-pill ms-1 @(Model.FiltroActual == "proximas" ? "bg-white text-danger" : "bg-secondary text-white")">@Model.TotalProximas</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(Model.FiltroActual == "completadas" ? "active bg-danger text-white" : "text-dark bg-light")"
               href="@Url.Action("MisReservas", "Reservas", new { tab = "completadas" })">
                Completadas <span class="badge rounded-pill ms-1 @(Model.FiltroActual == "completadas" ? "bg-white text-danger" : "bg-secondary text-white")">@Model.TotalCompletadas</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4 fw-bold @(Model.FiltroActual == "canceladas" ? "active bg-danger text-white" : "text-dark bg-light")"
               href="@Url.Action("MisReservas", "Reservas", new { tab = "canceladas" })">
                Canceladas <span class="badge rounded-pill ms-1 @(Model.FiltroActual == "canceladas" ? "bg-white text-danger" : "bg-secondary text-white")">@Model.TotalCanceladas</span>
            </a>
        </li>
    </ul>

    <!-- Listado de Tarjetas de Reserva -->
    @if (Model.Reservas != null && Model.Reservas.Any())
    {
        <div class="row g-4">
            @foreach (var res in Model.Reservas)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fs-5 fw-bold text-dark font-monospace">@res.CodigoReserva</span>
                                <span class="text-muted small">| Creada el @res.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                @if (res.EstadoReservaCodigo == "CANCELADA")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-x-circle me-1"></i> Cancelada
                                    </span>
                                }
                                else if (res.TieneCheckIn)
                                {
                                    <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold shadow-sm">
                                        <i class="bi bi-qr-code-scan me-1"></i> Check-in Listo
                                    </span>
                                }
                                else if (res.EstadoReservaCodigo == "CONFIRMADA")
                                {
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-clock-history me-1"></i> Confirmada (Check-in Pendiente)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill fw-bold">
                                        @res.EstadoReservaCodigo
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <div class="row align-items-center g-4">
                                <!-- Ruta e Itinerario -->
                                <div class="col-lg-4 col-md-6 border-end-md">
                                    <div class="d-flex align-items-center justify-content-between text-center mb-2">
                                        <div>
                                            <div class="display-6 fw-bold text-dark">@res.OrigenCodigo</div>
                                            <div class="text-muted small">@res.OrigenCiudad</div>
                                            <div class="fw-bold text-danger mt-1">@res.HoraSalida.ToString(@"hh\:mm")</div>
                                        </div>
                                        <div class="px-3 text-muted">
                                            <i class="bi bi-airplane-fill fs-4 text-danger"></i>
                                            <div class="small fw-bold font-monospace">@res.CodigoVuelo</div>
                                        </div>
                                        <div>
                                            <div class="display-6 fw-bold text-dark">@res.DestinoCodigo</div>
                                            <div class="text-muted small">@res.DestinoCiudad</div>
                                            <div class="fw-bold text-danger mt-1">@res.HoraLlegada.ToString(@"hh\:mm")</div>
                                        </div>
                                    </div>
                                    <div class="text-center text-muted small mt-2">
                                        <i class="bi bi-calendar3 me-1"></i> @res.FechaOperacion.ToString("dddd, dd MMMM yyyy")
                                    </div>
                                </div>

                                <!-- Aeronave y Pasajeros -->
                                <div class="col-lg-4 col-md-6 border-end-lg">
                                    <div class="mb-2">
                                        <span class="text-muted small">Aeronave:</span>
                                        <span class="fw-bold text-dark">@res.ModeloAeronave (@res.AeronaveMatricula)</span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-muted small">Tarifa:</span>
                                        <span class="badge bg-dark-subtle text-dark rounded-pill px-2">@res.Tarifa</span>
                                    </div>
                                    <div class="mb-1">
                                        <span class="text-muted small">Pasajero(s):</span>
                                        <span class="fw-semibold text-dark">
                                            @(res.PasajerosNombres != null && res.PasajerosNombres.Any() ? string.Join(", ", res.PasajerosNombres) : "Pasajero VIP")
                                        </span>
                                    </div>
                                    <div>
                                        <span class="text-muted small">Asientos reservados:</span>
                                        <span class="badge bg-danger text-white rounded-pill px-2 fw-bold font-monospace">@(string.IsNullOrWhiteSpace(res.AsientosCodigos) ? "Por asignar" : res.AsientosCodigos)</span>
                                    </div>
                                </div>

                                <!-- Importe y Acciones -->
                                <div class="col-lg-4 text-lg-end">
                                    <div class="text-muted small">Total Pagado:</div>
                                    <div class="h3 fw-bold text-dark mb-3">$@res.TotalPagado.ToString("N2") <small class="fs-6 text-muted">USD</small></div>

                                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                                        <a href="@Url.Action("Gestionar", "Reservas", new { id = res.CodigoReserva })" class="btn btn-outline-dark btn-sm rounded-pill fw-semibold px-3">
                                            <i class="bi bi-gear me-1"></i> Gestionar
                                        </a>

                                        @if (res.TieneCheckIn)
                                        {
                                            <a href="@Url.Action("PaseAbordar", "CheckIn", new { codigoReserva = res.CodigoReserva })" class="btn btn-success btn-sm rounded-pill fw-semibold px-3">
                                                <i class="bi bi-ticket-perforated me-1"></i> Ver Pases
                                            </a>
                                        }
                                        else if (res.PuedeHacerCheckIn)
                                        {
                                            <a href="@Url.Action("Index", "CheckIn", new { codigoReserva = res.CodigoReserva })" class="btn btn-danger btn-sm rounded-pill fw-semibold px-3" style="background-color: #E1251B; border-color: #E1251B;">
                                                <i class="bi bi-qr-code me-1"></i> Check-in
                                            </a>
                                        }

                                        <a href="@Url.Action("Comprobante", "Reservas", new { id = res.CodigoReserva })" class="btn btn-outline-secondary btn-sm rounded-pill fw-semibold px-3">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> SRI Factura
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Estado Vacío -->
        <div class="text-center py-5 bg-white rounded-4 shadow-sm my-4 p-5">
            <div class="mb-3">
                <i class="bi bi-airplane text-muted" style="font-size: 4rem;"></i>
            </div>
            <h3 class="h4 fw-bold text-dark">No se encontraron reservas</h3>
            <p class="text-muted mx-auto" style="max-width: 480px;">
                Actualmente no cuenta con reservas en la categoría seleccionada (@Model.FiltroActual). Explore nuestros itinerarios ejecutivos para reservar su próximo vuelo VIP.
            </p>
            <a href="@Url.Action("Buscar", "Vuelos")" class="btn btn-danger rounded-pill fw-bold px-4 py-2 mt-2" style="background-color: #E1251B; border-color: #E1251B;">
                <i class="bi bi-calendar-plus me-1"></i> Explorar Vuelos Disponibles
            </a>
        </div>
    }
</div>
