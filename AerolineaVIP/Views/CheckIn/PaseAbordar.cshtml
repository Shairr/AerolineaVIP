@model List<AerolineaVIP.Models.PaseAbordarDetalleViewModel>
@{
    ViewBag.Title = "Pases de Abordar VIP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    @if (TempData["MensajeCheckInExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 no-print" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
            <span>@TempData["MensajeCheckInExito"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Barra de Acciones Superior (Oculta en Impresión) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <a href="@Url.Action("MisReservas", "Reservas")" class="btn btn-outline-dark rounded-pill fw-bold px-4">
            <i class="bi bi-chevron-left me-1"></i> Volver a Mis Reservas
        </a>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-danger rounded-pill fw-bold px-4 shadow-sm" onclick="window.print();" style="background-color: #E1251B; border-color: #E1251B;">
                <i class="bi bi-printer-fill me-1"></i> Imprimir Pases de Abordar
            </button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var pase in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow border-0 rounded-4 overflow-hidden pase-abordar-card">
                        <div class="row g-0">
                            <!-- Cuerpo Principal del Boleto (70%) -->
                            <div class="col-md-8 p-4 p-lg-5 bg-white">
                                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-airplane-engines-fill text-danger fs-3"></i>
                                        <span class="fs-4 fw-black text-dark tracking-wide">AEROLÍNEA <span class="text-danger">VIP</span></span>
                                    </div>
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold text-uppercase">
                                        Boarding Pass / Ejecutivo
                                    </span>
                                </div>

                                <div class="row g-4 mb-4">
                                    <div class="col-sm-6">
                                        <span class="text-muted small text-uppercase fw-semibold d-block">Pasajero / Passenger</span>
                                        <span class="h5 fw-bold text-dark font-monospace text-uppercase">@pase.PasajeroNombre</span>
                                        <div class="text-muted small">Doc: @pase.PasajeroDocumento</div>
                                    </div>
                                    <div class="col-sm-6 text-sm-end">
                                        <span class="text-muted small text-uppercase fw-semibold d-block">Código de Reserva</span>
                                        <span class="h5 fw-bold text-danger font-monospace">@pase.CodigoReserva</span>
                                    </div>
                                </div>

                                <div class="row align-items-center text-center p-3 rounded-4 bg-light mb-4">
                                    <div class="col-4">
                                        <div class="display-6 fw-bold text-dark font-monospace">@pase.OrigenCodigo</div>
                                        <div class="text-muted small">@pase.OrigenCiudad</div>
                                    </div>
                                    <div class="col-4 text-danger">
                                        <i class="bi bi-airplane-fill fs-3"></i>
                                        <div class="small fw-bold font-monospace text-muted mt-1">@pase.CodigoVuelo</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="display-6 fw-bold text-dark font-monospace">@pase.DestinoCodigo</div>
                                        <div class="text-muted small">@pase.DestinoCiudad</div>
                                    </div>
                                </div>

                                <div class="row g-3 text-center border-top pt-3">
                                    <div class="col-3">
                                        <span class="text-muted small d-block">Fecha</span>
                                        <span class="fw-bold text-dark">@pase.FechaVuelo.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-muted small d-block">Hora Abordaje</span>
                                        <span class="fw-bold text-danger fs-5 font-monospace">@pase.HoraAbordaje</span>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-muted small d-block">Salida</span>
                                        <span class="fw-bold text-dark">@pase.HoraSalida</span>
                                    </div>
                                    <div class="col-3">
                                        <span class="text-muted small d-block">Puerta</span>
                                        <span class="fw-bold text-dark font-monospace">@pase.PuertaEmbarque</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Talón de Abordaje Desprendible (30%) -->
                            <div class="col-md-4 p-4 bg-dark text-white d-flex flex-column justify-content-between talon-pase border-start-dashed">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="small text-white-50 font-monospace">TALÓN VIP</span>
                                        <span class="badge bg-danger rounded-pill px-2">@pase.CodigoVuelo</span>
                                    </div>

                                    <div class="mb-3">
                                        <span class="text-white-50 small d-block">Pasajero</span>
                                        <div class="fw-bold text-truncate">@pase.PasajeroNombre</div>
                                    </div>

                                    <div class="d-flex justify-content-between mb-3">
                                        <div>
                                            <span class="text-white-50 small d-block">De:</span>
                                            <span class="fw-bold font-monospace">@pase.OrigenCodigo</span>
                                        </div>
                                        <div>
                                            <span class="text-white-50 small d-block">A:</span>
                                            <span class="fw-bold font-monospace">@pase.DestinoCodigo</span>
                                        </div>
                                    </div>

                                    <div class="p-3 rounded-3 bg-white text-dark text-center mb-3">
                                        <span class="text-muted small fw-bold text-uppercase d-block">Asiento VIP</span>
                                        <div class="display-5 fw-black text-danger font-monospace">@pase.Asiento</div>
                                        <span class="badge bg-dark text-white rounded-pill small px-2">@pase.GrupoEmbarque</span>
                                    </div>
                                </div>

                                <!-- QR Mock SVG -->
                                <div class="text-center p-2 bg-white rounded-3">
                                    <svg viewBox="0 0 100 100" width="90" height="90" class="d-block mx-auto">
                                        <rect width="100" height="100" fill="#ffffff" />
                                        <path d="M10,10 h30 v30 h-30 z M15,15 v20 h20 v-20 z M20,20 h10 v10 h-10 z" fill="#000000" />
                                        <path d="M60,10 h30 v30 h-30 z M65,15 v20 h20 v-20 z M70,20 h10 v10 h-10 z" fill="#000000" />
                                        <path d="M10,60 h30 v30 h-30 z M15,65 v20 h20 v-20 z M20,70 h10 v10 h-10 z" fill="#000000" />
                                        <rect x="45" y="15" width="8" height="8" fill="#000000" />
                                        <rect x="45" y="30" width="8" height="8" fill="#000000" />
                                        <rect x="45" y="45" width="8" height="8" fill="#000000" />
                                        <rect x="15" y="45" width="8" height="8" fill="#000000" />
                                        <rect x="30" y="45" width="8" height="8" fill="#000000" />
                                        <rect x="60" y="45" width="10" height="10" fill="#000000" />
                                        <rect x="75" y="45" width="15" height="8" fill="#000000" />
                                        <rect x="45" y="60" width="8" height="15" fill="#000000" />
                                        <rect x="60" y="60" width="12" height="12" fill="#000000" />
                                        <rect x="78" y="60" width="12" height="8" fill="#000000" />
                                        <rect x="60" y="78" width="8" height="12" fill="#000000" />
                                        <rect x="74" y="74" width="16" height="16" fill="#000000" />
                                    </svg>
                                    <small class="text-muted font-monospace d-block" style="font-size: 0.65rem;">ESCANEAR EN SALA VIP</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .border-start-dashed {
        border-left: 2px dashed rgba(255, 255, 255, 0.3) !important;
    }
    @@media print {
        .no-print, nav, footer, header {
            display: none !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .pase-abordar-card {
            page-break-inside: avoid !important;
            margin-bottom: 2rem !important;
            box-shadow: none !important;
            border: 1px solid #ccc !important;
        }
        body {
            background-color: #ffffff !important;
        }
    }
</style>
