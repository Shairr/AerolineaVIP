@model AerolineaVIP.Models.CheckInViewModel
@{
    ViewBag.Title = "Check-in en Línea - Reserva " + Model.CodigoReserva;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
            <span>@TempData["MensajeError"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("MisReservas", "Reservas")" class="text-decoration-none text-danger fw-bold"><i class="bi bi-chevron-left me-1"></i> Volver a Mis Reservas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Check-in en Línea</li>
        </ol>
    </nav>

    <!-- Encabezado de Vuelo y Reserva -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-danger text-white p-4 d-flex flex-wrap justify-content-between align-items-center" style="background-color: #E1251B !important;">
            <div>
                <span class="badge bg-white text-danger rounded-pill px-3 py-1 fw-bold text-uppercase mb-2">Check-in Express VIP</span>
                <h1 class="h3 fw-bold mb-1 font-monospace">Reserva @Model.CodigoReserva</h1>
                <p class="text-white-50 mb-0 small">Obtenga sus pases de abordar de forma instantánea para su vuelo ejecutivo.</p>
            </div>
            <div class="mt-3 mt-md-0 text-md-end">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold font-monospace fs-6">
                    <i class="bi bi-airplane-fill text-danger me-1"></i> @Model.CodigoVuelo
                </span>
            </div>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <div class="row align-items-center g-3 text-center text-md-start">
                <div class="col-md-5">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-4">
                        <div>
                            <div class="display-6 fw-bold text-dark">@Model.OrigenCodigo</div>
                            <div class="text-muted small">@Model.OrigenCiudad</div>
                            <div class="fw-bold text-danger">@Model.HoraSalida.ToString(@"hh\:mm")</div>
                        </div>
                        <div class="text-center px-2 text-danger">
                            <i class="bi bi-arrow-right fs-3"></i>
                        </div>
                        <div>
                            <div class="display-6 fw-bold text-dark">@Model.DestinoCodigo</div>
                            <div class="text-muted small">@Model.DestinoCiudad</div>
                            <div class="fw-bold text-danger">@Model.HoraLlegada.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 border-start-md">
                    <div class="small text-muted mb-1"><i class="bi bi-calendar-check me-1 text-danger"></i> Fecha: <strong>@Model.FechaOperacion.ToString("dddd, dd/MM/yyyy")</strong></div>
                    <div class="small text-muted"><i class="bi bi-jet me-1 text-danger"></i> Aeronave: <strong>Embraer Phenom 300E (@Model.AeronaveMatricula)</strong></div>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold">
                        Cabina Ejecutiva VIP (7 Asientos)
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CheckInTodosCompletado)
    {
        <!-- Estado: Check-in Ya Realizado -->
        <div class="card shadow-sm border-0 rounded-4 text-center p-5 mb-4">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h3 class="h4 fw-bold text-dark">¡Check-in Ya Completado!</h3>
            <p class="text-muted mx-auto" style="max-width: 500px;">
                Todos los pasajeros de esta reserva cuentan con su pase de abordar emitido y asiento asignado. Puede visualizar o imprimir sus pases directamente.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-3">
                <a href="@Url.Action("PaseAbordar", "CheckIn", new { codigoReserva = Model.CodigoReserva })" class="btn btn-danger fw-bold rounded-pill px-4 py-2" style="background-color: #E1251B; border-color: #E1251B;">
                    <i class="bi bi-qr-code-scan me-1"></i> Ver Pases de Abordar
                </a>
                <a href="@Url.Action("MisReservas", "Reservas")" class="btn btn-outline-dark fw-bold rounded-pill px-4 py-2">
                    Volver a Mis Reservas
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Formulario de Check-in -->
        using (Html.BeginForm("Procesar", "CheckIn", FormMethod.Post, new { id = "formCheckIn" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.CodigoReserva)

            <div class="row g-4">
                <!-- Columna Izquierda: Selección de Pasajeros y Declaración IATA -->
                <div class="col-lg-7">
                    <!-- Lista de Pasajeros -->
                    <div class="card shadow-sm border-0 rounded-4 mb-4">
                        <div class="card-header bg-white py-3 px-4 border-bottom">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-person-check-fill text-danger me-2"></i>1. Seleccione los Pasajeros para Check-in
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="list-group list-group-flush gap-2">
                                @for (int i = 0; i < Model.Pasajeros.Count; i++)
                                {
                                    var pas = Model.Pasajeros[i];
                                    <div class="list-group-item rounded-3 border p-3 d-flex align-items-center justify-content-between @(pas.YaTieneCheckIn ? "bg-light-subtle opacity-75" : "")">
                                        <div class="form-check d-flex align-items-center gap-3">
                                            @if (pas.YaTieneCheckIn)
                                            {
                                                <input class="form-check-input" type="checkbox" checked disabled />
                                                <div>
                                                    <div class="fw-bold text-dark">@pas.NombresCompletos</div>
                                                    <div class="text-muted small">Doc: @pas.Documento</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <input class="form-check-input checkin-pasajero" type="checkbox" name="AsignacionesSeleccionadas" value="@pas.AsignacionId" id="chk_@pas.AsignacionId" checked />
                                                <label class="form-check-label cursor-pointer" for="chk_@pas.AsignacionId">
                                                    <div class="fw-bold text-dark">@pas.NombresCompletos</div>
                                                    <div class="text-muted small">Doc: @pas.Documento</div>
                                                </label>
                                            }
                                        </div>

                                        <div class="text-end">
                                            <span class="badge bg-danger text-white rounded-pill px-3 py-2 font-monospace fw-bold fs-6">
                                                Asiento @pas.AsientoAsignado
                                            </span>
                                            <div class="mt-1">
                                                @if (pas.YaTieneCheckIn)
                                                {
                                                    <span class="badge bg-success-subtle text-success small rounded-pill">Abordaje listo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning small rounded-pill">Pendiente</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Declaración de Seguridad IATA -->
                    <div class="card shadow-sm border-0 rounded-4 mb-4 border-warning border-opacity-50">
                        <div class="card-header bg-white py-3 px-4 border-bottom">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="bi bi-shield-exclamation text-danger me-2"></i>2. Declaración de Seguridad y Mercancías Peligrosas
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="alert alert-light border small text-muted mb-3">
                                <i class="bi bi-info-circle-fill text-danger me-1"></i>
                                Conforme a las regulaciones de la <strong>IATA</strong> y la <strong>Dirección General de Aviación Civil (DGAC)</strong> del Ecuador, está estrictamente prohibido transportar en equipaje de mano o bodega: explosivos, gases comprimidos, líquidos inflamables, baterías de litio defectuosas o sustancias tóxicas.
                            </div>

                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.DeclaraSeguridad, new { @class = "form-check-input", @id = "chkSeguridad" })
                                <label class="form-check-label fw-semibold text-dark small" for="chkSeguridad">
                                    Declaro bajo juramento que ni yo ni mis acompañantes transportamos sustancias u objetos clasificados como mercancías peligrosas o prohibidas para el transporte aéreo.
                                </label>
                            </div>
                            @Html.ValidationMessageFor(m => m.DeclaraSeguridad, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <!-- Botón de Confirmación -->
                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill fw-bold shadow py-3" style="background-color: #E1251B; border-color: #E1251B;">
                            <i class="bi bi-qr-code me-2"></i> Confirmar Check-in y Emitir Pases de Abordar
                        </button>
                    </div>
                </div>

                <!-- Columna Derecha: Vista de la Cabina Phenom 300E -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-white py-3 px-4 border-bottom text-center">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i>Distribución de Asientos Phenom 300E
                            </h6>
                            <small class="text-muted">Capacidad exclusiva: 7 Asientos Ejecutivos</small>
                        </div>
                        <div class="card-body p-4 text-center">
                            <!-- Diagrama estilizado de la cabina -->
                            <div class="p-3 bg-light rounded-4 border mx-auto" style="max-width: 320px;">
                                <div class="text-muted small fw-bold text-uppercase mb-3">
                                    <i class="bi bi-arrow-up text-danger me-1"></i> Cabina de Mando (Pilotos)
                                </div>

                                <div class="mb-3 p-2 bg-white rounded-3 border">
                                    <span class="badge bg-secondary-subtle text-secondary small">Fila 1 (Lado Derecho)</span>
                                    <div class="mt-2">
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">1D</span>
                                    </div>
                                </div>

                                <div class="mb-3 p-2 bg-white rounded-3 border">
                                    <span class="badge bg-secondary-subtle text-secondary small">Fila 2 (Club Seating)</span>
                                    <div class="d-flex justify-content-around mt-2">
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">2I</span>
                                        <span class="text-muted small align-self-center">Pasillo</span>
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">2D</span>
                                    </div>
                                </div>

                                <div class="mb-3 p-2 bg-white rounded-3 border">
                                    <span class="badge bg-secondary-subtle text-secondary small">Fila 3 (Club Seating)</span>
                                    <div class="d-flex justify-content-around mt-2">
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">3I</span>
                                        <span class="text-muted small align-self-center">Pasillo</span>
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">3D</span>
                                    </div>
                                </div>

                                <div class="mb-2 p-2 bg-white rounded-3 border">
                                    <span class="badge bg-secondary-subtle text-secondary small">Fila 4 (Popa Ejecutiva)</span>
                                    <div class="d-flex justify-content-around mt-2">
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">4I</span>
                                        <span class="text-muted small align-self-center">Pasillo</span>
                                        <span class="badge bg-danger text-white p-2 font-monospace fw-bold fs-6">4D</span>
                                    </div>
                                </div>

                                <div class="text-muted small fw-bold text-uppercase mt-3">
                                    <i class="bi bi-arrow-down text-muted me-1"></i> Lavatorio / Galley VIP
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
