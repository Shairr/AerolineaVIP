@model AerolineaVIP.Models.Aeronave
@{
    ViewBag.Title = "Detalles de Aeronave " + Model.Matricula;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 800px;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-1">Pantalla 19 &bull; Ficha T&eacute;cnica</span>
                <h2 class="h4 fw-bold text-dark mb-0">Aeronave @Model.Matricula</h2>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Edit", new { id = Model.AeronaveId })" class="btn btn-avianca-primary-sm rounded-pill px-3">Editar</a>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">&larr; Volver</a>
            </div>
        </div>

        <div class="row g-3 small mb-4">
            <div class="col-md-4">
                <span class="text-muted d-block">Matr&iacute;cula:</span>
                <strong class="fs-5 font-monospace text-dark">@Model.Matricula</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted d-block">Modelo y Capacidad:</span>
                <strong class="text-dark">@(Model.ModeloAeronave?.Fabricante) @(Model.ModeloAeronave?.Nombre) (7 asientos)</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted d-block">Estado Operativo:</span>
                <span class="badge @(Model.EstadoAeronaveCodigo == "DISPONIBLE" ? "bg-success" : "bg-danger")">@Model.EstadoAeronaveCodigo</span>
            </div>
        </div>

        <h5 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Vuelos Programados / Operados por @Model.Matricula (@(Model.Vueloes?.Count ?? 0))</h5>
        @if (Model.Vueloes != null && Model.Vueloes.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Vuelo</th>
                            <th>Fecha</th>
                            <th>Ruta</th>
                            <th>Horario</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vueloes.OrderBy(x => x.FechaOperacion).Take(25))
                        {
                            <tr>
                                <td class="font-monospace fw-bold">VIP@(v.VueloId.ToString("D5"))</td>
                                <td>@v.FechaOperacion.ToString("dd/MM/yyyy")</td>
                                <td>@(v.Frecuencia?.Ruta?.Aeropuerto?.CodigoIATA) &rarr; @(v.Frecuencia?.Ruta?.Aeropuerto1?.CodigoIATA)</td>
                                <td>@(v.Frecuencia?.HoraSalida.ToString(@"hh\:mm")) - @(v.Frecuencia?.HoraLlegada.ToString(@"hh\:mm"))</td>
                                <td><span class="badge bg-secondary">@v.EstadoVueloCodigo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="small text-muted mb-0">Esta aeronave no tiene vuelos asignados todav&iacute;a.</p>
        }
    </div>
</div>
