@model AerolineaVIP.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar Contraseña";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-avianca shadow-2 p-4 p-md-5 border">
            <!-- Encabezado con Icono Corporativo -->
            <div class="text-center mb-4">
                <div class="brand-icon-flight mx-auto mb-3" style="width: 52px; height: 52px; font-size: 22px;">
                    &#128274;
                </div>
                <h2 class="h3 fw-bold mb-2 text-dark">Recuperar Contrase&ntilde;a</h2>
                <p class="text-secondary small mb-0">
                    Ingresa el correo electr&oacute;nico asociado a tu cuenta de Aerol&iacute;nea VIP y te enviaremos las instrucciones de restablecimiento.
                </p>
            </div>

            <!-- Formulario de Recuperación -->
            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", @class = "needs-validation" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "alert alert-danger py-2 small mb-3" })

                <div class="mb-4">
                    @Html.LabelFor(m => m.Email, "Correo Electr&oacute;nico", new { @class = "form-label fw-bold small text-dark" })
                    @Html.TextBoxFor(m => m.Email, new { 
                        @class = "form-control form-control-lg", 
                        placeholder = "ejemplo@aerolineavip.com",
                        type = "email",
                        required = "required",
                        style = "height: 52px;"
                    })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-avianca-primary w-100" style="height: 48px;">
                        Enviar enlace de recuperaci&oacute;n
                    </button>
                </div>
            }

            <!-- Enlaces de Retorno -->
            <div class="text-center pt-3 border-top mt-2">
                <p class="small text-secondary mb-0">
                    &iquest;Recordaste tus credenciales?
                    <a href="@Url.Action("Login", "Account")" class="fw-bold text-danger text-decoration-none">
                        Iniciar Sesi&oacute;n
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}