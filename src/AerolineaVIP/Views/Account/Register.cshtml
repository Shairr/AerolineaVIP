@model AerolineaVIP.Models.RegisterViewModel
@{
    ViewBag.Title = "Registro de Pasajero VIP";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card-avianca p-4 p-md-5 shadow-2">
            <div class="text-center mb-4">
                <span class="badge-role badge-role-cliente mb-2">Registro de Cliente VIP</span>
                <h2 class="h3 mb-1">Crea tu Cuenta</h2>
                <p class="text-muted small">Disfruta de reservas privadas y gestión de pasajes ejecutivos</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    <label class="form-label fw-bold small">Correo Electrónico</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "correo@ejemplo.com", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Contraseña</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 6 caracteres con números y símbolos" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small">Confirmar Contraseña</label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repite tu contraseña" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-avianca-primary w-100 mb-3">
                    Crear mi Cuenta VIP
                </button>
            }

            <div class="text-center pt-3 border-top">
                <p class="small text-muted mb-0">
                    ¿Ya tienes una cuenta registrada?
                    <a href="@Url.Action("Login", "Account")" class="fw-bold">Inicia Sesión aquí</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}