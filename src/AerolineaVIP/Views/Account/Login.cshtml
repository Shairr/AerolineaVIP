@using AerolineaVIP.Models
@model LoginViewModel
@{
    ViewBag.Title = "Iniciar Sesión";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card-avianca p-4 p-md-5 shadow-2">
            <!-- Encabezado con Icono Corporativo -->
            <div class="text-center mb-4">
                <div class="brand-icon-flight mx-auto mb-3" style="width: 48px; height: 48px;">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
                    </svg>
                </div>
                <h2 class="h3 mb-1">Bienvenido a Aerolínea VIP</h2>
                <p class="text-muted small">Ingresa tus credenciales para acceder a tu cuenta ejecutiva</p>
            </div>

            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                <div class="mb-3">
                    <label class="form-label fw-bold small">Usuario o Correo Electrónico</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Ej. admin01 o usuario@correo.com", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small">Contraseña</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "••••••••" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                        <label class="form-check-label small" for="RememberMe">Recordarme</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-avianca-primary w-100 mb-3">
                    Ingresar al Portal
                </button>
            }

            <div class="text-center pt-3 border-top">
                <p class="small text-muted mb-0">
                    ¿No tienes una cuenta aún?
                    <a href="@Url.Action("Register", "Account")" class="fw-bold">Regístrate como Cliente</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}