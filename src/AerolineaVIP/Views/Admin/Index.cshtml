@{
    ViewBag.Title = "Panel del administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="my-3">
    <!-- Título principal -->
    <h1 class="h2 fw-bold text-dark mb-4">Administración</h1>

    <!-- Las 4 Cajas de Acceso (Cuadrícula 2x2) -->
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <div class="card-avianca p-4 shadow-1 h-100 border">
                <a href="@Url.Action("Index", "VuelosAdmin")" class="btn btn-avianca-primary py-2 px-4">
                    Administrar vuelos e itinerarios
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card-avianca p-4 shadow-1 h-100 border">
                <a href="@Url.Action("Index", "AeronavesAdmin")" class="btn btn-avianca-primary py-2 px-4">
                    Gestionar aeronaves
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card-avianca p-4 shadow-1 h-100 border">
                <a href="@Url.Action("Index", "PasajerosAdmin")" class="btn btn-avianca-primary py-2 px-4">
                    Usuarios, pasajeros y reservas
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card-avianca p-4 shadow-1 h-100 border">
                <a href="@Url.Action("Reportes", "Admin")" class="btn btn-avianca-primary py-2 px-4">
                    Consultas y reportes
                </a>
            </div>
        </div>
    </div>
</div>
