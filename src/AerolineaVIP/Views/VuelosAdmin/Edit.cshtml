@model AerolineaVIP.Models.Vuelo
@{
    ViewBag.Title = "Editar Vuelo VIP" + Model.VueloId.ToString("D5");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 760px;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <h2 class="h4 fw-bold text-dark mb-0">Modificar Vuelo VIP@(Model.VueloId.ToString("D5"))</h2>
            </div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                &larr; Volver al Listado
            </a>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.VueloId)
            @Html.ValidationSummary(false, "", new { @class = "text-danger small fw-semibold mb-3" })

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-bold text-dark">Frecuencia y Ruta Autorizada *</label>
                    @Html.DropDownList("FrecuenciaId", null, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.FrecuenciaId, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Fecha de Operaci&oacute;n *</label>
                    @Html.TextBoxFor(m => m.FechaOperacion, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                    @Html.ValidationMessageFor(m => m.FechaOperacion, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Aeronave Asignada (Phenom 300E) *</label>
                    @Html.DropDownList("AeronaveId", null, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.AeronaveId, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Estado Operativo del Vuelo *</label>
                    @Html.DropDownList("EstadoVueloCodigo", null, new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.EstadoVueloCodigo, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-avianca-primary rounded-pill px-4">
                    Guardar Cambios
                </button>
            </div>
        }
    </div>
</div>
