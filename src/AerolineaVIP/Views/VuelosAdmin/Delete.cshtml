@model AerolineaVIP.Models.Vuelo
@{
    ViewBag.Title = "Eliminar / Cancelar Vuelo VIP" + Model.VueloId.ToString("D5");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 680px;">
        <div class="border-bottom pb-3 mb-4">
            <span class="badge bg-danger rounded-pill px-3 py-1 mb-1">Pantalla 18 &bull; Baja Operativa</span>
            <h2 class="h4 fw-bold text-dark mb-0">&iquest;Confirma dar de baja el Vuelo VIP@(Model.VueloId.ToString("D5"))?</h2>
        </div>

        <div class="alert alert-warning small">
            Si el vuelo cuenta con reservas o tramos de itinerario asociados, el sistema cambiar&aacute; su estado a <strong>CANCELADO</strong> para preservar la integridad referencial.
        </div>

        <div class="bg-light p-3 rounded border small mb-4">
            <div class="mb-1"><strong>Ruta:</strong> @(Model.Frecuencia?.Ruta?.Aeropuerto?.CodigoIATA) &rarr; @(Model.Frecuencia?.Ruta?.Aeropuerto1?.CodigoIATA)</div>
            <div class="mb-1"><strong>Fecha:</strong> @Model.FechaOperacion.ToString("dd/MM/yyyy") (@(Model.Frecuencia?.HoraSalida.ToString(@"hh\:mm")) - @(Model.Frecuencia?.HoraLlegada.ToString(@"hh\:mm")))</div>
            <div class="mb-1"><strong>Aeronave:</strong> @(Model.Aeronave?.Matricula)</div>
            <div><strong>Estado Actual:</strong> @Model.EstadoVueloCodigo</div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                    Confirmar Baja / Cancelaci&oacute;n
                </button>
            </div>
        }
    </div>
</div>
