@model IEnumerable<AerolineaVIP.Models.Vuelo>

@{
    ViewBag.Title = "Gestión de Vuelos VIP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card-avianca p-4 shadow-1 mt-3">
    <!-- Encabezado de la Pantalla 18 -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 border-bottom pb-3">
        <div>
            <span class="badge-role badge-role-administrador mb-1">Pantalla 18 · Módulo Operativo</span>
            <h2 class="h3 mb-0">Vuelos Programados</h2>
            <p class="text-muted small mb-0">Administración de itinerarios y aeronaves asignadas</p>
        </div>
        <div>
            <a href="@Url.Action("Create")" class="btn btn-avianca-primary">
                + Programar Nuevo Vuelo
            </a>
        </div>
    </div>

    <!-- Tabla Estilizada -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="small fw-bold text-uppercase">Fecha y Hora</th>
                    <th class="small fw-bold text-uppercase">Matrícula Aeronave</th>
                    <th class="small fw-bold text-uppercase">Frecuencia / Ruta</th>
                    <th class="small fw-bold text-uppercase">Estado</th>
                    <th class="small fw-bold text-uppercase text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            No hay vuelos programados actualmente en la base de datos.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                📅 @item.FechaOperacion.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    🛩 @(item.Aeronave != null ? item.Aeronave.Matricula : "Sin Asignar")
                                </span>
                            </td>
                            <td>
                                Frecuencia #@(item.Frecuencia != null ? item.Frecuencia.FrecuenciaId.ToString() : "-")
                            </td>
                            <td>
                                @if (item.EstadoVuelo != null)
                                {
                                    <span class="badge bg-success">@item.EstadoVuelo.Descripcion</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Sin Estado</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Edit", new { id = item.VueloId })" class="btn btn-sm btn-outline-secondary me-1" title="Editar">
                                    Editar
                                </a>
                                <a href="@Url.Action("Details", new { id = item.VueloId })" class="btn btn-sm btn-outline-info me-1" title="Ver Detalles">
                                    Detalles
                                </a>
                                <a href="@Url.Action("Delete", new { id = item.VueloId })" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>