@model AerolineaVIP.Models.PagoSimuladoViewModel

<!-- Modal Bootstrap 5 para confirmación de pago seguro -->
<div class="modal fade" id="modalConfirmarPago" tabindex="-1" aria-labelledby="modalConfirmarPagoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-3 rounded-4">
            <div class="modal-header bg-avianca text-white py-3">
                <h5 class="modal-title h6 fw-bold mb-0 d-flex align-items-center gap-2" id="modalConfirmarPagoLabel">
                    <span class="fs-5">&#128274;</span> Autorizaci&oacute;n de Pago Seguro
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <span class="badge bg-success text-white rounded-pill px-3 py-1 mb-2">&#128274; Transacci&oacute;n Cifrada 256-bit SSL</span>
                    <h3 class="h2 fw-bold text-danger mb-0" id="modalTotalPagar">
                        USD @(Model != null ? Model.TotalPagar.ToString("N2") : "0.00")
                    </h3>
                    <p class="small text-muted mb-0">Importe total autorizado a procesar</p>
                </div>

                <div class="card bg-light p-3 border rounded-3 mb-3">
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>C&oacute;digo de Reserva:</span>
                        <strong class="text-dark">@(Model?.CodigoPreReserva ?? "PRE-84920")</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>Vuelo:</span>
                        <strong class="text-dark">@(Model?.CodigoVuelo ?? "VIP00001") (@(Model?.OrigenCodigo) &rarr; @(Model?.DestinoCodigo))</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-secondary mb-1">
                        <span>Titular:</span>
                        <strong class="text-dark" id="modalTitular">@(Model?.TitularTarjeta ?? "CARLOS ROBERTO MENDOZA")</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-secondary">
                        <span>Instrumento:</span>
                        <strong class="text-dark" id="modalTarjeta">@(Model?.MarcaTarjeta ?? "VISA") &bull;&bull;&bull;&bull; 9010</strong>
                    </div>
                </div>

                <div class="alert alert-info border-0 small d-flex align-items-start gap-2 mb-0">
                    <span class="fs-5">&#128737;</span>
                    <div>
                        <strong>Confirmaci&oacute;n de Compra:</strong> Al hacer clic en <em>Confirmar Transacci&oacute;n</em>, se autorizar&aacute; el d&eacute;bito en su tarjeta y se generar&aacute;n autom&aacute;ticamente los pases de abordar electr&oacute;nicos oficiales.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top p-3 d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">
                    Volver y editar
                </button>
                <button type="button" class="btn btn-avianca-primary px-4" id="btnEjecutarPagoSubmit">
                    Confirmar Transacci&oacute;n &rarr;
                </button>
            </div>
        </div>
    </div>
</div>
