@model AerolineaVIP.Models.Pasajero
@{
    ViewBag.Title = "Eliminar Pasajero (Pantalla 20)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 660px;">
        <div class="border-bottom pb-3 mb-4">
            <h2 class="h4 fw-bold text-dark mb-0">&iquest;Confirma eliminar a @Model.Nombres @Model.Apellidos?</h2>
        </div>

        <div class="bg-light p-3 rounded border small mb-4">
            <div><strong>Documento:</strong> @Model.TipoDocumentoCodigo @Model.NumeroDocumento</div>
            <div><strong>Correo:</strong> @Model.Correo</div>
            <div><strong>Reservas asociadas:</strong> @(Model.ReservaPasajeroVueloes?.Count ?? 0)</div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", new { tab = "pasajeros" })" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Eliminar Registro</button>
            </div>
        }
    </div>
</div>
