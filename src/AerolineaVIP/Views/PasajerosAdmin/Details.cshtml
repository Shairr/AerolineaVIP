@model AerolineaVIP.Models.Pasajero
@{
    ViewBag.Title = "Detalles del Pasajero " + Model.Nombres + " " + Model.Apellidos;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 780px;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <span class="badge bg-danger rounded-pill px-3 py-1 mb-1">Pantalla 20 &bull; Ficha de Pasajero</span>
                <h2 class="h4 fw-bold text-dark mb-0">@Model.Nombres @Model.Apellidos</h2>
            </div>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Edit", new { id = Model.PasajeroId })" class="btn btn-avianca-primary-sm rounded-pill px-3">Editar</a>
                <a href="@Url.Action("Index", new { tab = "pasajeros" })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">&larr; Volver</a>
            </div>
        </div>

        <div class="row g-3 small mb-4">
            <div class="col-md-4">
                <span class="text-muted d-block">Documento:</span>
                <strong class="font-monospace text-dark">@Model.TipoDocumentoCodigo: @Model.NumeroDocumento</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted d-block">Fecha de Nacimiento:</span>
                <strong class="text-dark">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="col-md-4">
                <span class="text-muted d-block">Contacto:</span>
                <strong class="text-dark">@Model.Correo</strong>
                <div class="text-secondary">@Model.Telefono</div>
            </div>
        </div>

        <h5 class="h6 fw-bold text-dark border-bottom pb-2 mb-3">Historial de Vuelos y Reservas (@(Model.ReservaPasajeroVueloes?.Count ?? 0))</h5>
        @if (Model.ReservaPasajeroVueloes != null && Model.ReservaPasajeroVueloes.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle small mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Reserva</th>
                            <th>Vuelo</th>
                            <th>Ruta</th>
                            <th>Asiento</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.ReservaPasajeroVueloes)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-danger">@(a.Reserva?.CodigoReserva)</td>
                                <td class="font-monospace">VIP@(a.VueloId.ToString("D5")) (@(a.Vuelo?.FechaOperacion.ToString("dd/MM/yyyy")))</td>
                                <td>@(a.Vuelo?.Frecuencia?.Ruta?.Aeropuerto?.CodigoIATA) &rarr; @(a.Vuelo?.Frecuencia?.Ruta?.Aeropuerto1?.CodigoIATA)</td>
                                <td><span class="badge bg-danger">@AerolineaVIP.Controllers.VuelosController.MapearNumeroAsientoACodigo(a.NumeroAsiento)</span></td>
                                <td><span class="badge bg-secondary">@a.EstadoAsignacionCodigo</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="small text-muted mb-0">Este pasajero no registra reservas todav&iacute;a.</p>
        }
    </div>
</div>
