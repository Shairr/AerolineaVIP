@model AerolineaVIP.Models.Pasajero
@{
    ViewBag.Title = "Editar Pasajero (Pantalla 20)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="card card-avianca p-4 shadow-1 border mx-auto" style="max-width: 720px;">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <h2 class="h4 fw-bold text-dark mb-0">Modificar Datos de @Model.Nombres @Model.Apellidos</h2>
            </div>
            <a href="@Url.Action("Index", new { tab = "pasajeros" })" class="btn btn-outline-secondary btn-sm rounded-pill px-3">&larr; Volver</a>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.PasajeroId)
            @Html.HiddenFor(m => m.FechaRegistro)
            @Html.ValidationSummary(false, "", new { @class = "text-danger small fw-semibold mb-3" })

            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-dark">Tipo de Documento *</label>
                    @Html.DropDownList("TipoDocumentoCodigo", null, new { @class = "form-select" })
                </div>
                <div class="col-md-7">
                    <label class="form-label small fw-bold text-dark">N&uacute;mero de Documento *</label>
                    @Html.TextBoxFor(m => m.NumeroDocumento, new { @class = "form-control font-monospace", maxlength = "15", required = "required" })
                    @Html.ValidationMessageFor(m => m.NumeroDocumento, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Nombres Completos *</label>
                    @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", maxlength = "25", required = "required" })
                    @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-dark">Apellidos Completos *</label>
                    @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", maxlength = "25", required = "required" })
                    @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger small" })
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-dark">Fecha de Nacimiento *</label>
                    @Html.TextBoxFor(m => m.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-dark">Tel&eacute;fono Celular *</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", maxlength = "10", required = "required" })
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-dark">Correo Electr&oacute;nico *</label>
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", required = "required" })
                    @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="@Url.Action("Index", new { tab = "pasajeros" })" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
                <button type="submit" class="btn btn-avianca-primary rounded-pill px-4">Guardar Cambios</button>
            </div>
        }
    </div>
</div>
